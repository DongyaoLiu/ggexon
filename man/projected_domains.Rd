\name{projected_domains}
\alias{projected_domains}
\title{Access stored projected protein-domain tables}
\usage{
projected_domains(x)
}
\arguments{
\item{x}{A \code{SynIndividual} object.}
}
\value{
A named list of stored projected protein-domain tables.
}
\description{
Returns the contents of the \code{projected_domains} slot on a
\code{SynIndividual}.
}
